NODE_ENV=development
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgresql://memory:memory@localhost:5432/agent_memory
MEMORY_OWNER_ID=local-user
# Leave blank for localhost-only development without an API key.
MEMORY_API_KEY=
MAX_MEMORY_CONTENT_CHARS=12000
MAX_CHECKPOINT_CONTENT_CHARS=12000
SESSION_RETENTION_DAYS=2
# Scopes holding at most this many memories are returned in full by search.
SEARCH_BYPASS_MAX_SCOPE_SIZE=50
